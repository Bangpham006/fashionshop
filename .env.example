# ========================================================
# FASHIONSHOP ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Sao chép file này thành .env và điền các giá trị thực tế
# ========================================================

# MongoDB Atlas URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fashionshop_db?retryWrites=true&w=majority
DB_NAME=fashionshop_db

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI API Key (Dùng cho AI Stylist Chatbot)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Ports
PORT_BACKEND=8080
PORT_AI=8000
PORT_FRONTEND=3000
